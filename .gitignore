# dependencies
node_modules/

# build output
dist/
.astro/
*.tsbuildinfo

# generated example outputs (regenerate with `npm run example`)
examples/out/

# env / secrets
.env
.env.*
*.pem
*.key

# local tooling / OS
.claude/settings.local.json
.DS_Store
Thumbs.db
*.log

# local icon cache (official Azure/AWS packs are never committed)
.dgm/

# official icon zips dropped for `dgm icons update` (never committed)
icons-inbox/*
!icons-inbox/README.md
!icons-inbox/.gitkeep

# installed copy of skills/diagram-author (regenerate with `dgm skill install`)
.claude/skills/diagram-author/

# editor / tooling
.claude/launch.json
.vscode/
.idea/
coverage/
