---
import Base from "../layouts/Base.astro";
import Playground from "../playground/Playground";

const title = "declarative-diagrams — playground";
const description =
  "Write a little YAML, get an interactive diagram: architecture (AWS, Azure), flows and data models. Runs in your browser.";
---

<Base title={title} description={description} bare>
  <Playground client:only="react">
    <p slot="fallback" class="loadingPage">Loading the playground…</p>
  </Playground>
  <noscript>
    <p class="loadingPage">The playground needs JavaScript: the diagram engine runs in your browser.</p>
  </noscript>
</Base>

<style>
  .loadingPage {
    padding: 3rem;
    text-align: center;
    color: var(--text-muted);
    font: 15px var(--sans);
  }
</style>
