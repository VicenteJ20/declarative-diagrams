---
const { frontmatter } = Astro.props;
---
<html lang="es">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
    <title>{frontmatter.title}</title>
    <style is:global>
      :root{color-scheme:light dark}
      body{font-family:Georgia,serif;max-width:720px;margin:3rem auto;padding:0 1rem;line-height:1.65}
      @media (prefers-color-scheme:dark){body{background:#16151c;color:#e8e6f0}}
    </style>
  </head>
  <body><h1>{frontmatter.title}</h1><slot /></body>
</html>
