{
  "name": "declarative-diagrams",
  "private": true,
  "license": "MIT",
  "author": "Vicente Jorquera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VicenteJ20/declarative-diagrams.git"
  },
  "homepage": "https://github.com/VicenteJ20/declarative-diagrams#readme",
  "bugs": {
    "url": "https://github.com/VicenteJ20/declarative-diagrams/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "site-demo"
  ],
  "scripts": {
    "build": "npm run build -w @declarative-diagrams/core && npm run build -w @declarative-diagrams/cli && npm run build -w @declarative-diagrams/react && npm run build -w @declarative-diagrams/mcp",
    "test": "vitest run",
    "example": "node packages/cli/dist/index.js render examples/azure-landing-zone.diagram.yaml -o examples/out/azure-landing-zone.svg",
    "demo:dev": "npm run dev -w site-demo",
    "demo:build": "npm run build -w site-demo",
    "gallery": "node scripts/build-gallery.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
