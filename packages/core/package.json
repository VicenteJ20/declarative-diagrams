{
  "name": "@declarative-diagrams/core",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Vicente Jorquera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VicenteJ20/declarative-diagrams.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/VicenteJ20/declarative-diagrams#readme",
  "bugs": {
    "url": "https://github.com/VicenteJ20/declarative-diagrams/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts src/runtime.ts src/themes.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "elkjs": "^0.12.1",
    "fflate": "^0.8.3",
    "lucide": "^1.77.0",
    "yaml": "^2.6.0",
    "zod": "^4.6.6"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "diagrams",
    "svg",
    "yaml",
    "architecture",
    "mcp",
    "azure",
    "aws"
  ]
}
