{
  "name": "@declarative-diagrams/react",
  "version": "0.1.0",
  "license": "MIT",
  "author": "Vicente Jorquera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VicenteJ20/declarative-diagrams.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/VicenteJ20/declarative-diagrams#readme",
  "bugs": {
    "url": "https://github.com/VicenteJ20/declarative-diagrams/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.tsx src/vite.ts --format esm --dts --clean --external react"
  },
  "dependencies": {
    "@declarative-diagrams/core": "^0.1.0",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "react": "^18.3.1",
    "vite": "^6.0.0"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "diagrams",
    "svg",
    "yaml",
    "architecture",
    "mcp",
    "azure",
    "aws"
  ]
}
